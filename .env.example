# ==========================================
# TaskPulse Environment Variables (Template)
# ==========================================
# NOTE: Never commit production credentials or real secret keys to version control.
# Copy this file to .env.local for local development.

# Application Configuration
NEXT_PUBLIC_APP_NAME="TaskPulse Agile Hub"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telemetry & Diagnostics
NEXT_PUBLIC_HEALTH_CHECK_ENABLED="true"

# Mock Database & API Service Placeholders (No real secrets)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskpulse_dev?sslmode=disable"
API_SECRET_TOKEN="placeholder-dev-token-do-not-use-in-prod"
